# Spotify Web API (PKCE) — create an app at https://developer.spotify.com/dashboard
# Development Mode requires a Premium account on the app owner.
SPOTIPY_CLIENT_ID=your_client_id_here

# Redirect URI registered on the Spotify app. Two options (see docs/guide/03-spotify-app.md):
#  A) GitHub Pages relay from YOUR copy of this repo (docs/spotify-callback.html):
#       https://<your-github-user>.github.io/spot-revival/spotify-callback.html
#  B) No GitHub Pages: a loopback address. Spotify allows http only for 127.0.0.1.
#     After approving, your phone shows an error page; copy its full address into
#     "Paste redirect URL" on the setup page.
#       http://127.0.0.1:8888/callback
SPOTIPY_REDIRECT_URI=https://YOUR_GITHUB_USER.github.io/spot-revival/spotify-callback.html

# Optional: override paths (defaults match install.sh layout)
# SPOTIFYPOD_DATA_DIR=/var/lib/spotifypod
# SPOTIFYPOD_TOKEN_PATH=/var/lib/spotifypod/token.json
# GO_LIBRESPOT_URL=http://127.0.0.1:3678
# PORTAL_HOST=ipod.local

# Blank the display after N seconds without wheel input (0 = never). Default 60.
# SCREEN_TIMEOUT_SECONDS=60
